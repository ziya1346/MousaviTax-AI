# MousaviTax AI – Environment Variables
# Copy this file to .env and fill in the values

# Application
ENVIRONMENT=development
APP_NAME=MousaviTax AI
APP_VERSION=0.1.0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_USER=mousavi
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mousavitax
DATABASE_URL=postgresql://mousavi:change_me@localhost:5432/mousavitax

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers (optional for Sprint 01)
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
